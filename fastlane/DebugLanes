platform :ios do
  desc "Verify build number logic without uploading"
  lane :test_build_number do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_CONTENT"],
      is_key_content_base64: true
    )

    version = get_version_number(
      xcodeproj: "TimerStamp.xcodeproj",
      target: "TimerStamp"
    )

    latest = latest_testflight_build_number(
      api_key: api_key,
      version: version,
      initial_build_number: 0
    )

    UI.message("Version: #{version}")
    UI.message("Latest build on TestFlight: #{latest}")
    UI.message("Next build number will be: #{latest + 1}")
  end
end
